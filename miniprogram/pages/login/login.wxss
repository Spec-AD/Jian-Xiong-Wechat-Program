/* pages/login/login.wxss */

/* 全局 page 背景设为渐变，防止加载白块闪烁 */
page {
  background: linear-gradient(160deg, var(--theme-color) 0%, var(--theme-light) 50%, #F5F5F5 100%);
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(160deg, var(--theme-color) 0%, var(--theme-light) 50%, #F5F5F5 100%);
}

/* ===== 顶部头部 ===== */
.login-header {
  width: 100%;
  padding: 100rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.2);
  margin-bottom: 24rpx;
}

.login-title {
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-subtitle {
  color: rgba(255,255,255,0.80);
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* ===== 登录卡片 ===== */
.login-card {
  width: calc(100% - 64rpx);
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 56rpx 40rpx 48rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(66,0,59,0.12);
}

/* ===== 主要按钮 ===== */
.btn-primary {
  display: block;
  width: 100%;
  padding: 24rpx 0;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--theme-color);
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

/* ===== 间距工具 ===== */
.mt-8  { margin-top: 8rpx; }
.mt-32 { margin-top: 32rpx; }

/* ===== 底部 ===== */
.login-footer {
  margin-top: auto;
  padding: 48rpx 0 60rpx;
  text-align: center;
}