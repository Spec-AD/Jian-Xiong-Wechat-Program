/* pages/login/login.wxss — 健雄书院登录页样式（重构版：南大紫主题） */

/* ===== 全局 ===== */
page {
  background: var(--bg-page);
  overflow-x: hidden;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(170deg, var(--theme-color) 0%, var(--theme-dark) 35%, var(--bg-page) 100%);
  position: relative;
  overflow: hidden;
}

/* ===== 顶部装饰波纹 ===== */
.hero-wave {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  overflow: hidden;
  pointer-events: none;
}

.wave {
  position: absolute;
  bottom: 0;
  left: -10%;
  width: 120%;
  height: 100rpx;
  border-radius: 50%;
  opacity: 0.15;
}

.wave-1 {
  background: #fff;
  height: 80rpx;
  bottom: -20rpx;
  animation: waveAnim 8s ease-in-out infinite;
}

.wave-2 {
  background: #fff;
  height: 60rpx;
  bottom: -10rpx;
  opacity: 0.10;
  animation: waveAnim 10s ease-in-out infinite reverse;
}

.wave-3 {
  background: #fff;
  height: 40rpx;
  bottom: 0;
  opacity: 0.08;
  animation: waveAnim 6s ease-in-out infinite;
}

@keyframes waveAnim {
  0%, 100% { transform: translateX(-5%) rotate(-2deg); }
  50% { transform: translateX(5%) rotate(2deg); }
}

/* ===== 顶部品牌区 ===== */
.hero-section {
  width: 100%;
  padding: 100rpx 48rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

.logo-ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 0 60rpx rgba(255, 255, 255, 0.08);
  animation: logoPulse 3s ease-in-out infinite;
}

@keyframes logoPulse {
  0%, 100% { box-shadow: 0 0 60rpx rgba(255, 255, 255, 0.08); }
  50% { box-shadow: 0 0 100rpx rgba(255, 255, 255, 0.15); }
}

.login-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
}

.login-title {
  color: #FFFFFF;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 12rpx;
}

.login-subtitle {
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  font-weight: 400;
}

/* ===== 登录卡片 ===== */
.login-card {
  width: calc(100% - 64rpx);
  max-width: 640rpx;
  margin: 0 32rpx;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0 16rpx 60rpx rgba(66, 0, 59, 0.14);
  position: relative;
  z-index: 2;
  animation: cardSlideUp 0.6s ease-out;
}

@keyframes cardSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-header {
  margin-bottom: 36rpx;
  text-align: center;
}

.card-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.card-desc {
  display: block;
  font-size: 26rpx;
  color: var(--c-text-sub);
  line-height: 1.5;
}

/* ===== 错误提示 ===== */
.error-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fef0f0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #ffcdd2;
}

.error-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.error-text {
  font-size: 24rpx;
  color: var(--c-danger);
  flex: 1;
  line-height: 1.4;
}

/* ===== 登录按钮 ===== */
.login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  background: var(--theme-gradient);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 36rpx rgba(106, 0, 95, 0.30);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 6rpx 20rpx rgba(106, 0, 95, 0.25);
}

.login-btn--loading {
  opacity: 0.85;
}

.login-btn--loading:active {
  transform: none;
}

/* 按钮内容 */
.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-icon {
  font-size: 36rpx;
}

.btn-label {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 3rpx;
}

/* 加载动画 */
.btn-loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  animation: dotBounce 1.4s ease-in-out infinite both;
}

.dot-1 { animation-delay: -0.32s; }
.dot-2 { animation-delay: -0.16s; }
.dot-3 { animation-delay: 0s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.6; }
  40% { transform: scale(1.1); opacity: 1; }
}

.btn-loading-text {
  font-size: 28rpx;
  color: #ffffff;
  margin-left: 12rpx;
  font-weight: 500;
}

/* ===== 协议 ===== */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 28rpx;
  gap: 4rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.agreement-link {
  font-size: 22rpx;
  color: var(--theme-light);
  font-weight: 500;
}

/* ===== 特色标签 ===== */
.features-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 36rpx;
  padding: 20rpx 0 0;
  border-top: 2rpx solid var(--c-border);
  gap: 0;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-label {
  font-size: 22rpx;
  color: var(--c-text-sub);
  font-weight: 500;
}

.feature-divider {
  width: 2rpx;
  height: 32rpx;
  background: var(--c-border);
  flex-shrink: 0;
}

/* ===== 底部 ===== */
.login-footer {
  margin-top: auto;
  padding: 40rpx 0 50rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  position: relative;
  z-index: 1;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 1rpx;
}

.footer-version {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.30);
}

/* ===== 屏幕适配 ===== */
@media (max-height: 700px) {
  .hero-section {
    padding-top: 60rpx;
    padding-bottom: 30rpx;
  }
  .logo-ring {
    width: 128rpx;
    height: 128rpx;
  }
  .login-logo {
    width: 90rpx;
    height: 90rpx;
  }
  .login-title {
    font-size: 44rpx;
  }
  .login-card {
    padding: 32rpx 28rpx;
  }
  .card-title {
    font-size: 34rpx;
  }
}