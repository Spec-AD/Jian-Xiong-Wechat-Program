<!-- pages/login/login.wxml -->
<view class="login-page">

  <!-- 顶部背景区 -->
  <view class="login-header">
    <image class="login-logo" src="/assets/images/logo.png" mode="aspectFit" />
    <text class="login-title">健雄书院</text>
    <text class="login-subtitle">南京大学学生成果展示平台</text>
  </view>

  <!-- 登录卡片 -->
  <view class="login-card">
    <view class="login-desc" style="text-align:center;margin-bottom:48rpx;">
      <text class="text-lg text-bold">欢迎来到健雄书院</text>
      <text class="text-secondary text-sm text-center mt-8" style="display:block;">
        点击下方按钮，一键登录体验
      </text>
    </view>

    <!-- 一键登录 -->
    <button class="btn-primary" bindtap="handleQuickLogin" loading="{{loading}}">
      一键登录
    </button>

    <text class="text-secondary text-sm text-center mt-32" style="display:block;">
      登录即代表同意《用户协议》与《隐私政策》
    </text>
  </view>

  <!-- 底部装饰 -->
  <view class="login-footer">
    <text class="text-secondary text-sm">南京大学健雄书院 © 2024</text>
  </view>

</view>