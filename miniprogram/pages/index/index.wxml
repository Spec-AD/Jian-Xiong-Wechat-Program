<!--pages/index/index.wxml-->
<view class="page">

  <!-- ===== Hero 区域 ===== -->
  <view class="hero">
    <view class="logo-wrap">
      <text class="logo-text">健雄</text>
    </view>
    <text class="title">健雄书院</text>
    <text class="subtitle">南京大学 · 学生成果展示平台</text>
  </view>

  <!-- ===== 已登录状态 ===== -->
  <view wx:if="{{hasUserInfo}}" class="login-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <text class="welcome">欢迎回来</text>
    <text class="nickname">{{userInfo.nickName}}</text>
    <button class="enter-btn" bindtap="onEnter">进入大厅 →</button>
    <button class="logout-btn" bindtap="onLogout">切换账号</button>
  </view>

  <!-- ===== 未登录：授权区域 ===== -->
  <view wx:else class="login-card">
    <text class="login-tip">完善信息，探索同学的精彩成果</text>

    <!-- 头像选择（微信新规）-->
    <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar-placeholder" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="avatar-edit-badge">📷</view>
    </button>

    <!-- 昵称输入（type=nickname 触发微信键盘昵称推荐）-->
    <view class="nickname-row">
      <text class="nickname-label">昵称</text>
      <input
        type="nickname"
        class="nickname-input"
        placeholder="点击填写昵称"
        bind:change="onInputChange"
        confirm-type="done"
      />
    </view>

    <button
      class="enter-btn {{hasUserInfo ? '' : 'enter-btn--disabled'}}"
      loading="{{loading}}"
      bindtap="onLogin"
    >授权并进入</button>

    <button class="guest-btn" bindtap="goHall">游客浏览</button>

    <text class="terms-text">登录即同意《用户协议》与《隐私政策》</text>
  </view>

  <view class="footer">
    <text class="footer-text">© 2024 南京大学健雄书院</text>
  </view>

</view>
