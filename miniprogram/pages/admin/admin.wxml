<!--pages/admin/admin.wxml-->
<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-screen">
    <text class="loading-icon"></text>
    <text class="loading-text">验证权限…</text>
  </view>

  <block wx:else>

    <!-- ===== Header ===== -->
    <view class="admin-header">
      <text class="admin-title">管理后台</text>
      <view class="admin-badge">管理员</view>
      <view class="admin-refresh" bindtap="onRefresh">
        <text></text>
      </view>
    </view>

    <!-- ===== Tab 切换 ===== -->
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === 'stats' ? 'tab-item--active' : ''}}"
        bindtap="onTabChange"
        data-tab="stats"
      >
        <text class="tab-text">仪表盘</text>
      </view>
      <view
        class="tab-item {{activeTab === 'works' ? 'tab-item--active' : ''}}"
        bindtap="onTabChange"
        data-tab="works"
      >
        <text class="tab-text">作品管理</text>
      </view>
      <view
        class="tab-item {{activeTab === 'cos-import' ? 'tab-item--active' : ''}}"
        bindtap="onTabChange"
        data-tab="cos-import"
      >
        <text class="tab-text">COS导入</text>
      </view>
    </view>

    <!-- ===== 仪表盘 ===== -->
    <view wx:if="{{activeTab === 'stats'}}" class="stats-section">
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-icon"></text>
          <text class="stat-value">{{stats.totalWorks}}</text>
          <text class="stat-label">作品总数</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon"></text>
          <text class="stat-value">{{stats.totalUsers}}</text>
          <text class="stat-label">用户总数</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon"></text>
          <text class="stat-value">{{stats.todayViews}}</text>
          <text class="stat-label">今日浏览</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon"></text>
          <text class="stat-value">{{stats.totalLikes}}</text>
          <text class="stat-label">总点赞数</text>
        </view>
      </view>

      <view class="quick-actions">
        <text class="quick-title">快捷操作</text>
        <view class="quick-grid">
          <view class="quick-item" bindtap="onTabChange" data-tab="works">
            <text class="quick-icon"></text>
            <text class="quick-label">管理作品</text>
          </view>
          <view class="quick-item" bindtap="onRefresh">
            <text class="quick-icon"></text>
            <text class="quick-label">刷新数据</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 作品管理 ===== -->
    <view wx:elif="{{activeTab === 'works'}}" class="works-section">

      <!-- 搜索 -->
      <view class="search-bar">
        <input
          class="search-input"
          placeholder="搜索作品标题…"
          value="{{keyword}}"
          bindinput="onSearch"
          confirm-type="search"
        />
      </view>

      <!-- 筛选 -->
      <scroll-view class="filter-scroll" scroll-x enable-flex>
        <view
          class="filter-chip {{filterType === 'all' ? 'filter-chip--active' : ''}}"
          bindtap="onFilterType"
          data-type="all"
        >全部</view>
        <view
          class="filter-chip {{filterType === 'video' ? 'filter-chip--active' : ''}}"
          bindtap="onFilterType"
          data-type="video"
        >视频</view>
        <view
          class="filter-chip {{filterType === 'audio' ? 'filter-chip--active' : ''}}"
          bindtap="onFilterType"
          data-type="audio"
        >音频</view>
        <view
          class="filter-chip {{filterType === 'image' ? 'filter-chip--active' : ''}}"
          bindtap="onFilterType"
          data-type="image"
        >图片</view>
        <view
          class="filter-chip {{filterType === 'doc' ? 'filter-chip--active' : ''}}"
          bindtap="onFilterType"
          data-type="doc"
        >文档</view>
      </scroll-view>

      <!-- 列表 -->
      <view wx:if="{{works.length > 0}}" class="work-list">
        <view class="work-item" wx:for="{{works}}" wx:key="_id">
          <view class="work-info" bindtap="onViewWork" data-id="{{item._id}}">
            <text class="work-type-icon"></text>
            <view class="work-meta">
              <text class="work-title">{{item.title}}</text>
              <text class="work-sub">
                {{item.actualAuthor || '未知作者'}} · {{item.date || ''}} · {{item.views || 0}} 次浏览
              </text>
            </view>
          </view>
          <view class="work-actions">
            <button class="work-edit-btn" bindtap="onEditWork" data-id="{{item._id}}">编辑</button>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:else class="empty-state">
        <text class="empty-icon"></text>
        <text class="empty-text">暂无作品数据</text>
      </view>

      <!-- 加载更多 -->
      <view wx:if="{{refreshing}}" class="loading-more">
        <text>加载中…</text>
      </view>
    </view>

    <!-- ===== COS 资源导入 ===== -->
    <view wx:elif="{{activeTab === 'cos-import'}}" class="cos-section">
      
      <!-- 加载状态 -->
      <view wx:if="{{cosLoading}}" class="loading-state">
        <text class="loading-text">正在列取 COS 资源…</text>
      </view>

      <block wx:else>
        <!-- 统计概览 -->
        <view class="cos-stats-row" wx:if="{{cosStats}}">
          <view class="cos-stat-card">
            <text class="cos-stat-value">{{cosStats.totalFiles}}</text>
            <text class="cos-stat-label">总文件数</text>
          </view>
          <view class="cos-stat-card">
            <text class="cos-stat-value">{{cosStats.totalSizeFormatted}}</text>
            <text class="cos-stat-label">总大小</text>
          </view>
          <view class="cos-stat-card" wx:for="{{['video','image','doc']}}" wx:key="*">
            <text class="cos-stat-value">{{cosStats.categoryCount[item]}}</text>
            <text class="cos-stat-label">{{item === 'video' ? '视频' : item === 'image' ? '图片' : '文档'}}</text>
          </view>
        </view>

        <!-- 操作栏 -->
        <view class="cos-toolbar">
          <view class="cos-search-bar">
            <input
              class="cos-search-input"
              placeholder="搜索文件名…"
              value="{{cosSearchText}}"
              bindinput="onCosSearch"
            />
          </view>
          <scroll-view class="cos-filter-scroll" scroll-x enable-flex>
            <view class="cos-filter-chip {{cosFilterType === 'all' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="all">全部</view>
            <view class="cos-filter-chip {{cosFilterType === 'mp4' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="mp4">MP4</view>
            <view class="cos-filter-chip {{cosFilterType === 'mov' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="mov">MOV</view>
            <view class="cos-filter-chip {{cosFilterType === 'jpg' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="jpg">JPG</view>
            <view class="cos-filter-chip {{cosFilterType === 'png' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="png">PNG</view>
            <view class="cos-filter-chip {{cosFilterType === 'pdf' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="pdf">PDF</view>
            <view class="cos-filter-chip {{cosFilterType === 'xlsx' ? 'cos-filter-chip--active' : ''}}" bindtap="onCosFilterType" data-type="xlsx">XLSX</view>
          </scroll-view>
        </view>

        <!-- 批量操作 -->
        <view class="cos-batch-bar" wx:if="{{cosObjects.length > 0}}">
          <view class="cos-select-all" bindtap="onCosSelectAll">
            <text class="cos-checkbox {{cosSelectAll ? 'cos-checkbox--checked' : ''}}"></text>
            <text class="cos-select-label">{{cosSelectAll ? '取消全选' : '全选'}}</text>
          </view>
          <text class="cos-selected-count">已选 {{cosSelectedKeys.length}} / {{filteredCosObjects.length}} 项</text>
          <button
            class="cos-import-btn {{cosSelectedKeys.length === 0 ? 'cos-import-btn--disabled' : ''}}"
            disabled="{{cosSelectedKeys.length === 0 || cosImporting}}"
            loading="{{cosImporting}}"
            bindtap="onCosImport"
          >
            导入选中
          </button>
        </view>

        <!-- 导入结果提示 -->
        <view wx:if="{{cosImportResult}}" class="cos-result">
          <text class="cos-result-text">
            ✅ 导入完成：成功 {{cosImportResult.imported}} 个，跳过 {{cosImportResult.skipped}} 个
          </text>
          <text wx:if="{{cosImportResult.errors.length > 0}}" class="cos-result-error">
            ❌ 失败 {{cosImportResult.errors.length}} 个
          </text>
        </view>

        <!-- 资源列表 -->
        <view wx:if="{{cosObjects.length > 0}}" class="cos-list">
          <view
            class="cos-item {{cosSelectedKeys.indexOf(item.key) > -1 ? 'cos-item--selected' : ''}}"
            wx:for="{{filteredCosObjects}}"
            wx:key="key"
            bindtap="onCosSelect"
            data-key="{{item.key}}"
          >
            <view class="cos-checkbox-wrap">
              <text class="cos-checkbox {{cosSelectedKeys.indexOf(item.key) > -1 ? 'cos-checkbox--checked' : ''}}"></text>
            </view>
            <view class="cos-item-icon">
              <text class="cos-ext-badge">{{item.ext.replace('.','')}}</text>
            </view>
            <view class="cos-item-info">
              <text class="cos-item-name">{{item.fileName}}</text>
              <text class="cos-item-meta">
                {{_getExtLabel(item.ext)}} · {{_formatSize(item.size)}} · {{item.lastModified.slice(0,10)}}
              </text>
            </view>
          </view>
        </view>

        <!-- 空状态 -->
        <view wx:else class="empty-state">
          <text class="empty-icon"></text>
          <text class="empty-text">COS 中暂无资源文件</text>
          <text class="empty-hint">请确认文件已上传到 COS 的 resources/ 目录下</text>
        </view>
      </block>

    </view>

  </block>

</view>
