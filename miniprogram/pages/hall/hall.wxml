<!--pages/hall/hall.wxml-->
<view class="page">

  <!-- ===== 沉浸式海报轮播（节选自作品的 cover，最多 5 张）===== -->
  <swiper
    wx:if="{{bannerList.length > 0}}"
    class="poster-swiper"
    autoplay
    interval="5000"
    circular
    indicator-dots
    indicator-color="rgba(255,255,255,0.35)"
    indicator-active-color="#ffffff"
  >
    <swiper-item
      wx:for="{{bannerList}}"
      wx:key="id"
      bindtap="onBannerTap"
      data-item="{{item}}"
    >
      <view class="poster-item">
        <image
          class="poster-img"
          src="{{item.coverUrl}}"
          mode="aspectFill"
        />
        <view class="poster-overlay">
          <view class="poster-tag">{{item.typeName}}</view>
          <text class="poster-title">{{item.title}}</text>
          <text class="poster-author">{{item.actualAuthor || '未知作者'}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- ===== 分类标签 ===== -->
  <scroll-view class="tab-scroll" scroll-x enable-flex>
    <view class="tab-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="tab-item {{activeCategory === item.id ? 'tab-item--active' : ''}}"
        bindtap="onTabTap"
        data-id="{{item.id}}"
      >
        {{item.icon}} {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- ===== 搜索栏（点击 FAB 按钮后显示）===== -->
  <view class="search-section" wx:if="{{showSearch}}">
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索作品标题…"
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
        focus="{{showSearch}}"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onSearchClear">
        <text class="search-clear-icon">✕</text>
      </view>
    </view>
  </view>

  <!-- ===== 列表区域头（含返回大厅按钮）===== -->
  <view class="list-header">
    <view class="list-header-left">
      <text wx:if="{{mode !== 'hall'}}" class="back-btn" bindtap="onBackToHall">‹ 返回大厅</text>
      <text class="list-header-text">{{mode === 'hall' ? (activeCategory === 'external' ? '外链作品' : '全部作品') : mode === 'my' ? '我的发布' : mode === 'liked' ? '我的点赞' : '浏览记录'}}</text>
    </view>
    <text class="list-count">共 {{total}} 项</text>
  </view>

  <!-- ===== 作品网格 ===== -->
  <view class="work-grid">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="work-card"
      bindtap="onWorkTap"
      data-item="{{item}}"
    >
      <!-- 封面（cover 优先，图片类型无 cover 时用 fileUrl 兜底） -->
      <view class="card-cover">
        <image
          wx:if="{{item.cover}}"
          class="cover-img"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
        <image
          wx:elif="{{item.type === 'image' && item.fileUrl}}"
          class="cover-img"
          src="{{item.fileUrl}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="cover-placeholder">
          <text class="cover-icon">{{item.typeIcon}}</text>
        </view>
        <view class="type-badge">{{item.typeName}}</view>
      </view>

      <!-- 信息 -->
      <view class="card-info">
        <!-- 外链作品：标题带超链接样式 + 平台图标 -->
        <view wx:if="{{activeCategory === 'external'}}" class="card-title-row">
          <image wx:if="{{item.platformIcon}}" class="card-platform-icon" src="{{item.platformIcon}}" mode="aspectFit" />
          <text class="card-title card-title--link">{{item.title}}</text>
        </view>
        <!-- 普通作品 -->
        <text wx:else class="card-title">{{item.title}}</text>
        <text class="card-author">{{item.actualAuthor || '未知作者'}}</text>
        <view class="card-meta">
          <text class="card-date">{{item.date}}</text>
          <view class="card-stats">
            <text class="stat-text">浏览 {{item.views}}</text>
            <text class="stat-text">赞 {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中提示 -->
  <view wx:if="{{loading && works.length > 0}}" class="list-bottom">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && works.length === 0}}" class="empty">
    <text class="empty-icon"></text>
    <text class="empty-text">{{mode === 'my' ? '还没有发布作品哦' : mode === 'liked' ? '还没有点赞过作品' : mode === 'history' ? '还没有浏览过作品' : '暂无相关作品'}}</text>
  </view>

  <!-- ===== 右下角悬浮搜索按钮（外链作品Tab时隐藏）===== -->
  <view wx:if="{{activeCategory !== 'external'}}" class="search-fab" bindtap="goToSearch">
    <image class="search-fab-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiFileSearch.png" mode="aspectFit" />
  </view>

  <view class="list-bottom"></view>

</view>
