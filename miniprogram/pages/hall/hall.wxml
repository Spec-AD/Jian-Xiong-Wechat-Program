<!--pages/hall/hall.wxml-->
<view class="page">

  <!-- ===== 顶部搜索栏 ===== -->
  <view class="search-bar">
    <view class="search-inner">
      <text class="search-icon"></text>
      <input
        class="search-input"
        placeholder="搜索作品、作者、标签…"
        bindinput="onSearch"
        value="{{keyword}}"
        confirm-type="search"
      />
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">✕</text>
    </view>
  </view>

  <!-- ===== Banner 轮播（推荐作品）===== -->
  <swiper
    wx:if="{{bannerList.length > 0}}"
    class="banner-swiper"
    autoplay
    interval="4000"
    circular
    indicator-dots
    indicator-color="rgba(255,255,255,0.5)"
    indicator-active-color="#ffffff"
  >
    <swiper-item
      wx:for="{{bannerList}}"
      wx:key="id"
      bindtap="onBannerTap"
      data-item="{{item}}"
    >
      <view class="banner-item">
        <image
          wx:if="{{item.cover || (item.type === 'image' && item.fileUrl)}}"
          class="banner-img"
          src="{{item.cover || item.fileUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="banner-placeholder">
          <text class="banner-icon">{{item.typeIcon}}</text>
        </view>
        <view class="banner-overlay">
          <view class="banner-tag">{{item.typeName}}</view>
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-author">{{item.actualAuthor || '未知作者'}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- ===== 分类标签 ===== -->
  <scroll-view class="tab-scroll" scroll-x enable-flex>
    <view class="tab-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="tab-item {{activeCategory === item.id ? 'tab-item--active' : ''}}"
        bindtap="onTabTap"
        data-id="{{item.id}}"
      >
        {{item.icon}} {{item.name}}
      </view>
    </view>
  </scroll-view>

  <!-- ===== 列表区域头（含返回大厅按钮）===== -->
  <view class="list-header">
    <view class="list-header-left">
      <text wx:if="{{mode !== 'hall'}}" class="back-btn" bindtap="onBackToHall">‹ 返回大厅</text>
      <text class="list-header-text">{{mode === 'hall' ? '全部作品' : mode === 'my' ? '我的发布' : mode === 'liked' ? '我的点赞' : '浏览记录'}}</text>
    </view>
    <text class="list-count">共 {{total}} 项</text>
  </view>

  <!-- ===== 作品网格 ===== -->
  <view class="work-grid">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="work-card"
      bindtap="onWorkTap"
      data-item="{{item}}"
    >
      <!-- 封面（cover 优先，图片类型无 cover 时用 fileUrl 兜底） -->
      <view class="card-cover">
        <image
          wx:if="{{item.cover}}"
          class="cover-img"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
        <image
          wx:elif="{{item.type === 'image' && item.fileUrl}}"
          class="cover-img"
          src="{{item.fileUrl}}"
          mode="aspectFill"
          lazy-load
        />
        <view wx:else class="cover-placeholder">
          <text class="cover-icon">{{item.typeIcon}}</text>
        </view>
        <view class="type-badge">{{item.typeName}}</view>
      </view>

      <!-- 信息 -->
      <view class="card-info">
        <text class="card-title">{{item.title}}</text>
        <text class="card-author">{{item.actualAuthor || '未知作者'}}</text>
        <view class="card-meta">
          <text class="card-date">{{item.date}}</text>
          <view class="card-stats">
            <text class="stat-text">浏览 {{item.views}}</text>
            <text class="stat-text">赞 {{item.likes}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载中提示 -->
  <view wx:if="{{loading && works.length > 0}}" class="list-bottom">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && works.length === 0}}" class="empty">
    <text class="empty-icon"></text>
    <text class="empty-text">{{mode === 'my' ? '还没有发布作品哦' : mode === 'liked' ? '还没有点赞过作品' : mode === 'history' ? '还没有浏览过作品' : '暂无相关作品'}}</text>
  </view>

  <view class="list-bottom"></view>

</view>
