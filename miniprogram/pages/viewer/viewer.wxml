<!--pages/viewer/viewer.wxml-->
<view class="page">

  <!-- ===== 视频 ===== -->
  <view wx:if="{{type === 'video'}}" class="media-wrap">
    <video
      class="video-player"
      src="{{fileUrl}}"
      controls
      autoplay="{{false}}"
      show-fullscreen-btn
      show-play-btn
      enable-progress-gesture
      object-fit="contain"
      poster=""
    />
  </view>

  <!-- ===== 音频播放器 ===== -->
  <view wx:elif="{{type === 'audio'}}" class="audio-wrap">
    <view class="audio-disc {{audioPlaying ? 'audio-disc--spin' : ''}}">
      <text class="audio-disc-icon">🎵</text>
    </view>
    <text class="audio-title">{{title}}</text>
    <text class="audio-time-row">
      <text class="audio-cur">{{audioCurrentTime}}</text>
      <text class="audio-sep"> / </text>
      <text class="audio-dur">{{audioDurationText}}</text>
    </text>
    <slider
      class="audio-slider"
      value="{{audioProgress}}"
      max="{{audioDuration}}"
      bindchange="onSliderChange"
      activeColor="#4a90e2"
      backgroundColor="#e8edf5"
      block-size="18"
    />
    <view class="audio-btn-row">
      <view class="audio-ctrl-btn" bindtap="onSeekBack">
        <text class="ctrl-icon">⏪</text>
        <text class="ctrl-label">15s</text>
      </view>
      <view class="audio-play-btn" bindtap="onAudioPlay">
        <text class="play-icon">{{audioPlaying ? '⏸' : '▶'}}</text>
      </view>
      <view class="audio-ctrl-btn" bindtap="onSeekForward">
        <text class="ctrl-label">15s</text>
        <text class="ctrl-icon">⏩</text>
      </view>
    </view>
  </view>

  <!-- ===== 图片（支持长图 + 多图）===== -->
  <view wx:elif="{{type === 'image'}}" class="image-wrap">
    <!-- 多图横向滑动 -->
    <block wx:if="{{imageList.length > 1}}">
      <scroll-view scroll-x class="image-h-scroll" enable-flex>
        <view class="image-h-inner">
          <image
            wx:for="{{imageList}}"
            wx:key="index"
            class="image-h-item"
            src="{{item}}"
            mode="aspectFill"
            lazy-load
            bindtap="onImageTap"
            data-src="{{item}}"
          />
        </view>
      </scroll-view>
      <text class="image-hint">← 左右滑动查看多图 · 点击全屏</text>
    </block>
    <!-- 单图竖向滚动（长图）-->
    <block wx:else>
      <scroll-view scroll-y class="image-v-scroll">
        <image
          class="preview-image"
          src="{{fileUrl}}"
          mode="widthFix"
          lazy-load
          bindtap="onImageTap"
          data-src="{{fileUrl}}"
        />
      </scroll-view>
      <text class="image-hint">支持长图滚动 · 点击全屏查看</text>
    </block>
  </view>

  <!-- ===== PDF / 文档 ===== -->
  <view wx:elif="{{type === 'doc'}}" class="doc-wrap">
    <view class="doc-preview-card">
      <text class="doc-big-icon">📄</text>
      <text class="doc-name">{{title}}</text>
      <text class="doc-sub">PDF 文档</text>
    </view>
    <button
      class="doc-open-btn"
      loading="{{docLoading}}"
      bindtap="onOpenDoc"
    >在微信内打开文档</button>
    <text class="doc-tip">文档将在微信内置阅读器中打开\n支持从菜单转发或保存</text>
  </view>

  <!-- ===== 不支持的格式 ===== -->
  <view wx:else class="unsupported">
    <text class="unsupported-icon">🔗</text>
    <text class="unsupported-text">暂不支持该文件格式</text>
    <button class="open-btn" bindtap="onOpenDoc">尝试打开</button>
  </view>

  <!-- ===== 底部操作栏（通用）===== -->
  <view class="action-bar">
    <view class="action-btn" bindtap="onLike">
      <text class="action-icon">{{liked ? '❤️' : '🤍'}}</text>
      <text class="action-label">{{liked ? '已赞' : '点赞'}}</text>
      <text class="action-count">{{likesCount || ''}}</text>
    </view>
    <view class="action-btn" bindtap="onShare">
      <text class="action-icon">📤</text>
      <text class="action-label">分享</text>
    </view>
    <view class="action-btn" bindtap="onDownload">
      <text class="action-icon">⬇️</text>
      <text class="action-label">下载</text>
    </view>
  </view>

</view>