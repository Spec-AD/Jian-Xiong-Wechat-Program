<!--viewer.wxml-->
<view class="page">

  <!-- 标题栏 -->
  <view class="header">
    <text class="header-title">{{title}}</text>
  </view>

  <!-- 视频 -->
  <view wx:if="{{type === 'video'}}" class="media-wrap">
    <video
      class="video-player"
      src="{{fileUrl}}"
      controls
      autoplay="{{false}}"
      show-fullscreen-btn
      show-play-btn
      enable-progress-gesture
      objectFit="contain"
    />
  </view>

  <!-- 音频 -->
  <view wx:elif="{{type === 'audio'}}" class="audio-wrap">
    <view class="audio-cover">
      <text class="audio-icon">🎵</text>
    </view>
    <view class="audio-title">{{title}}</view>
    <view class="audio-controls">
      <text class="ctrl-btn" bindtap="onAudioPlay">{{audioPlaying ? '⏸' : '▶'}}</text>
      <slider
        class="audio-slider"
        value="{{audioProgress}}"
        max="{{audioDuration}}"
        bindchange="onSliderChange"
        activeColor="#4a90e2"
        block-size="16"
      />
      <view class="audio-time">
        <text>{{audioCurrentTime}}</text>
        <text>{{audioDurationText}}</text>
      </view>
    </view>
  </view>

  <!-- 图片（含长图） -->
  <view wx:elif="{{type === 'image'}}" class="image-wrap">
    <scroll-view scroll-y class="image-scroll">
      <image
        class="preview-image"
        src="{{fileUrl}}"
        mode="widthFix"
        lazy-load
        bindtap="onImageTap"
      />
    </scroll-view>
    <text class="image-hint">点击图片可全屏查看</text>
  </view>

  <!-- PDF / 文档 -->
  <view wx:elif="{{type === 'doc'}}" class="doc-wrap">
    <view class="doc-card" bindtap="onOpenDoc">
      <text class="doc-icon">📄</text>
      <view class="doc-info">
        <text class="doc-name">{{title}}</text>
        <text class="doc-hint">点击在微信内打开文档</text>
      </view>
      <text class="doc-arrow">›</text>
    </view>
  </view>

  <!-- 无法识别 -->
  <view wx:else class="unsupported">
    <text class="unsupported-icon">🔗</text>
    <text class="unsupported-text">暂不支持该文件格式</text>
    <button class="open-btn" bindtap="onOpenDoc">在浏览器中打开</button>
  </view>

</view>