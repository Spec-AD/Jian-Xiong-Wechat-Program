<view class="page">

  <!-- ===== 首次使用引导 ===== -->
  <view wx:if="{{firstTime}}" class="guide-overlay">
    <view class="guide-card">
      <text class="guide-icon"></text>
      <text class="guide-title">欢迎来到健雄书院</text>
      <text class="guide-desc">在这里你可以展示学业、科研、文艺、志愿服务等各方面的优秀成果。</text>
      <button class="guide-btn" bindtap="onCloseGuide">我知道了</button>
    </view>
  </view>



  <!-- ===== 用户信息头部 ===== -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <image
        class="profile-avatar"
        src="{{userInfo.avatarUrl || 'https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/%E7%BB%93%E5%90%88%E8%BF%99%E4%B8%A4%E5%BC%A0%E5%9B%BE%E7%89%87%EF%BC%881.%E5%8D%97%E4%BA%AC%E5%A4%A7%E5%AD%A6%E6%A0%A1%E6%A0%87%EF%BC%9B2.%E5%90%B4%E5%81%A5%E9%9B%84%E5%85%88%E7%94%9F%E7%85%A7%EF%BC%89%EF%BC%8C%E4%B8%BA%E6%88%91%E7%94%9F_2026-05-10_12-00-37.png'}}"
        mode="aspectFill"
      />
    </view>
    <view class="profile-info">
      <view class="name-row">
        <text class="profile-name {{isVerified ? 'profile-name--verified' : ''}}">{{userInfo.nickName || '书院同学'}}</text>
        <text wx:if="{{isVerified}}" class="verified-badge"></text>
      </view>
      <text class="profile-uid">UID: {{uid}}</text>
      <text wx:if="{{signature}}" class="profile-sig">「{{signature}}」</text>
      <view wx:if="{{birthday}}" class="profile-detail-row">
        <text class="profile-detail-label">🎂 生日</text>
        <text class="profile-detail-value">{{birthday}}</text>
      </view>
      <view wx:if="{{region.length > 0}}" class="profile-detail-row">
        <text class="profile-detail-label">📍 地域</text>
        <text class="profile-detail-value">{{regionDisplay}}</text>
      </view>
      <view wx:if="{{interests.length > 0}}" class="profile-detail-row">
        <text class="profile-detail-label">🏷️ 兴趣</text>
        <view class="profile-interests">
          <text wx:for="{{interests}}" wx:key="index" class="profile-interest-tag">{{item}}</text>
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 数据统计（可点击→数据中心）===== -->
  <view class="stats-card" bindtap="onMenuTap" data-key="dataCenter">
    <view class="stat-item">
      <text class="stat-num">{{stats.publishCount}}</text>
      <text class="stat-label">发布</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.likeCount}}</text>
      <text class="stat-label">获赞</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.viewCount}}</text>
      <text class="stat-label">浏览</text>
    </view>
    <view class="stat-arrow">›</view>
  </view>

  <!-- ===== 我的内容 ===== -->
  <view class="menu-group">
    <text class="menu-group-title">我的内容</text>
    <view class="menu-item" bindtap="onMenuTap" data-key="myPublish">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiArrowExpandUp%20%281%29.png" mode="aspectFit" />
      <text class="menu-label">我的发布</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-key="myLike">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiHeart.png" mode="aspectFit" />
      <text class="menu-label">我的点赞</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-key="history">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiAccountDetails.png" mode="aspectFit" />
      <text class="menu-label">浏览记录</text>
      <text class="menu-tag">{{historyCount}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item menu-item--last" bindtap="onMenuTap" data-key="downloads">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiArrowCollapseDown.png" mode="aspectFit" />
      <text class="menu-label">我的下载</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 创作 ===== -->
  <view class="menu-group">
    <text class="menu-group-title">创作</text>
    <view class="menu-item" bindtap="onMenuTap" data-key="publish">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiKnob.png" mode="aspectFit" />
      <text class="menu-label">发布作品</text>
      <view wx:if="{{!canPublish}}" class="menu-tag menu-tag--disabled">暂不可用</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 账户与设置 ===== -->
  <view class="menu-group">
    <text class="menu-group-title">账户与设置</text>
    <view class="menu-item" bindtap="onMenuTap" data-key="editProfile">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiBookEdit.png" mode="aspectFit" />
      <text class="menu-label">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item menu-item--last" bindtap="onMenuTap" data-key="settings">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/MdiCog.png" mode="aspectFit" />
      <text class="menu-label">设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 管理 ===== -->
  <view wx:if="{{isAdmin}}" class="menu-group">
    <text class="menu-group-title">管理</text>
    <view class="menu-item" bindtap="onMenuTap" data-key="admin">
      <text class="menu-icon"></text>
      <text class="menu-label">管理后台</text>
      <view class="menu-tag menu-tag--verified">管理员</view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 社区 ===== -->
  <view class="menu-group">
    <text class="menu-group-title">社区</text>
    <view class="menu-item" bindtap="onMenuTap" data-key="github">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/SimpleIconsGithub.png" mode="aspectFit" />
      <text class="menu-label">GitHub 仓库</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item menu-item--last" bindtap="onMenuTap" data-key="afdian">
      <image class="menu-icon" src="https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/SimpleIconsAfdian.png" mode="aspectFit" />
      <text class="menu-label">爱发电支持</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 退出 ===== -->
  <view class="logout-wrap">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <view class="footer">
    <text class="footer-text">南京大学健雄书院 © 2024 · v1.0.0</text>
  </view>

</view>