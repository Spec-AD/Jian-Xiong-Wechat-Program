<view class="page">

  <!-- ===== 头像区 ===== -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image
        class="avatar-img"
        src="{{profile.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}"
        mode="aspectFill"
      />
      <view class="avatar-badge">
        <text wx:if="{{!uploading}}"></text>
        <text wx:else></text>
      </view>
    </button>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <!-- ===== 表单 ===== -->
  <view class="form-wrap">

    <!-- 昵称 -->
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        placeholder="请输入昵称"
        value="{{profile.nickName}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- UID（只读）-->
    <view class="form-row">
      <text class="form-label">UID</text>
      <text class="form-value readonly">自动生成</text>
    </view>

    <!-- 签名 -->
    <view class="form-row form-row--textarea">
      <text class="form-label">签名</text>
      <textarea
        class="form-textarea"
        placeholder="一句话介绍自己…"
        value="{{profile.signature}}"
        bindinput="onSignatureInput"
        maxlength="100"
        auto-height
      />
    </view>

    <!-- 生日 -->
    <view class="form-row">
      <text class="form-label">生日</text>
      <picker
        mode="date"
        value="{{birthdayDate}}"
        start="1950-01-01"
        end="2010-12-31"
        bindchange="onBirthdayChange"
      >
        <text class="form-value picker-value">{{profile.birthday || '选择生日'}}</text>
      </picker>
    </view>

    <!-- 地域 -->
    <view class="form-row">
      <text class="form-label">地域</text>
      <picker
        mode="region"
        value="{{region}}"
        bindchange="onRegionChange"
      >
        <text class="form-value picker-value">{{profile.region ? profile.region.join(' · ') : '选择地域'}}</text>
      </picker>
    </view>

    <!-- 兴趣 -->
    <view class="form-row form-row--col">
      <text class="form-label">兴趣</text>
      <view class="interests-wrap">
        <view
          wx:for="{{interestOptions}}"
          wx:key="index"
          class="interest-tag {{profile.interests.indexOf(item) >= 0 ? 'interest-tag--active' : ''}}"
          bindtap="onInterestTap"
          data-interest="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 保存按钮 ===== -->
  <view class="save-wrap">
    <button
      class="g-btn-primary"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSave"
    >保存资料</button>
  </view>

</view>
