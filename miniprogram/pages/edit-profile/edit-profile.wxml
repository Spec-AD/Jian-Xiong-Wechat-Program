<view class="page">

  <!-- ===== 头像区 ===== -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image
        class="avatar-img"
        src="{{profile.avatarUrl || 'https://jianxiong-public-assets-1406049668.cos.ap-nanjing.myqcloud.com/resources/%E7%BB%93%E5%90%88%E8%BF%99%E4%B8%A4%E5%BC%A0%E5%9B%BE%E7%89%87%EF%BC%881.%E5%8D%97%E4%BA%AC%E5%A4%A7%E5%AD%A6%E6%A0%A1%E6%A0%87%EF%BC%9B2.%E5%90%B4%E5%81%A5%E9%9B%84%E5%85%88%E7%94%9F%E7%85%A7%EF%BC%89%EF%BC%8C%E4%B8%BA%E6%88%91%E7%94%9F_2026-05-10_12-00-37.png'}}"
        mode="aspectFill"
      />
      <view class="avatar-badge">
        <text wx:if="{{!uploading}}"></text>
        <text wx:else></text>
      </view>
    </button>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <!-- ===== 表单 ===== -->
  <view class="form-wrap">

    <!-- 昵称 -->
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="nickname"
        placeholder="点击填写昵称（可使用微信昵称）"
        value="{{profile.nickName}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <!-- 签名 -->
    <view class="form-row form-row--textarea">
      <text class="form-label">签名</text>
      <textarea
        class="form-textarea"
        placeholder="一句话介绍自己…"
        value="{{profile.signature}}"
        bindinput="onSignatureInput"
        maxlength="100"
        auto-height
      />
    </view>

    <!-- 生日 -->
    <view class="form-row">
      <text class="form-label">生日</text>
      <picker
        mode="date"
        value="{{birthdayDate}}"
        start="1950-01-01"
        end="2010-12-31"
        bindchange="onBirthdayChange"
      >
        <text class="form-value picker-value">{{profile.birthday || '选择生日'}}</text>
      </picker>
    </view>

    <!-- 地域 -->
    <view class="form-row">
      <text class="form-label">地域</text>
      <picker
        mode="region"
        value="{{region}}"
        bindchange="onRegionChange"
      >
        <text class="form-value picker-value">{{regionDisplay}}</text>
      </picker>
    </view>

    <!-- 兴趣 -->
    <view class="form-row form-row--col">
      <text class="form-label">兴趣</text>
      <view class="interests-wrap">
        <view
          wx:for="{{interestTags}}"
          wx:key="index"
          class="interest-tag {{item.active ? 'interest-tag--active' : ''}}"
          bindtap="onInterestTap"
          data-interest="{{item.name}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

  </view>

  <!-- ===== 保存按钮 ===== -->
  <view class="save-wrap">
    <button
      class="g-btn-primary"
      loading="{{saving}}"
      disabled="{{saving}}"
      bindtap="onSave"
    >保存资料</button>
  </view>

</view>
