/* pages/downloads/downloads.wxss — 我的下载页样式 */

page {
  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 统计栏 ===== */
.stats-bar {
  display: flex;
  align-items: center;
  background: var(--theme-gradient);
  padding: 24rpx 32rpx;
  margin: 0 0 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.stat-num--success {
  color: #81c784;
}

.stat-num--active {
  color: #64b5f6;
}

.stat-num--danger {
  color: #ef9a9a;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  padding: 0 24rpx 16rpx;
  gap: 12rpx;
}

.filter-chip {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--c-text-sub);
  background: #f0f0f5;
  transition: all 0.2s;
}

.filter-chip--active {
  background: var(--theme-color);
  color: #fff;
  font-weight: 600;
}

.filter-spacer {
  flex: 1;
}

.filter-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #f0f0f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-action--danger {
  background: #fef0f0;
}

.filter-action-icon {
  font-size: 28rpx;
}

/* ===== 列表 ===== */
.scroll-list {
  flex: 1;
  padding: 0 24rpx;
}

.download-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(66, 0, 59, 0.06);
  position: relative;
  overflow: hidden;
}

.download-item--done {
  opacity: 0.85;
}

/* 管理删除 */
.item-delete {
  position: absolute;
  top: 0;
  left: 0;
  width: 60rpx;
  height: 100%;
  background: var(--c-danger);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.item-delete-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

/* 文件图标 */
.item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-icon-text {
  font-size: 32rpx;
}

/* 文件信息 */
.item-body {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.item-status--downloading {
  color: #1976d2;
  background: #e3f2fd;
}

.item-status--completed {
  color: #388e3c;
  background: #e8f5e9;
}

.item-status--failed {
  color: #d32f2f;
  background: #fef0f0;
}

.item-status--paused {
  color: #f57c00;
  background: #fff3e0;
}

.item-meta-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.item-meta {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

/* 进度条 */
.progress-bar-wrap {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e8edf5;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-bar-fill--downloading {
  background: var(--theme-gradient);
}

.progress-bar-fill--completed {
  background: #66bb6a;
}

.progress-bar-fill--failed {
  background: #ef5350;
}

.item-speed-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.item-speed-text {
  font-size: 20rpx;
  color: var(--c-text-sub);
}

.item-error {
  margin-top: 4rpx;
}

.item-error-text {
  font-size: 20rpx;
  color: var(--c-danger);
}

.item-time {
  margin-top: 4rpx;
}

.item-time-text {
  font-size: 20rpx;
  color: var(--c-text-sub);
}

/* 操作按钮 */
.item-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-action-btn {
  width: 72rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: rgba(106, 0, 95, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-text {
  font-size: 22rpx;
  color: var(--theme-color);
  font-weight: 600;
}

/* ===== 空状态 ===== */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--c-text-sub);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  background: var(--theme-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 28rpx rgba(106, 0, 95, 0.25);
}

/* ===== 底部 ===== */
.footer {
  padding: 24rpx 0 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: var(--c-text-sub);
}
