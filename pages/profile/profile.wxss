/* pages/profile/profile.wxss */

.profile-page {
  background: var(--color-bg);
  min-height: 100vh;
}

/* ===== 头部 ===== */
.profile-header {
  background: linear-gradient(135deg, #4A2C6E, #7B4FA6);
  padding: 48rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-name { color: #FFFFFF; }
.profile-sub  { color: rgba(255,255,255,0.75); }

/* ===== 统计卡片 ===== */
.stats-card {
  margin: -32rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  position: relative;
  z-index: 10;
}

.stat-col {
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
}

/* ===== 菜单分组 ===== */
.menu-section {
  margin: 0 24rpx 24rpx;
  padding: 0 0 0;
  overflow: hidden;
  border-radius: 16rpx;
}

.menu-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 20rpx 28rpx 12rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  background: #FAFAFA;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-top: 1rpx solid var(--color-border);
  gap: 20rpx;
}

.menu-icon {
  font-size: 36rpx;
  width: 48rpx;
  text-align: center;
}

.menu-label {
  font-size: 30rpx;
  color: var(--color-text);
}

.menu-arrow {
  color: var(--color-text-secondary);
  font-size: 40rpx;
  font-weight: 300;
}

/* ===== 退出按钮 ===== */
.logout-btn {
  border-color: #E53935;
  color: #E53935;
  margin-top: 8rpx;
}

/* ===== 底部 ===== */
.profile-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 40rpx 0 60rpx;
}