<!-- pages/profile/profile.wxml -->
<view class="profile-page">

  <!-- ===== 用户信息头部 ===== -->
  <view class="profile-header">
    <image
      class="profile-avatar"
      src="{{userInfo.avatarUrl || '/assets/images/default_avatar.png'}}"
      mode="aspectFill"
    />
    <view class="profile-info">
      <text class="profile-name text-bold text-xl">{{userInfo.nickName || '书院同学'}}</text>
      <text class="profile-sub text-sm" style="color:rgba(255,255,255,0.75);">
        南京大学健雄书院
      </text>
    </view>
  </view>

  <!-- ===== 数据统计 ===== -->
  <view class="stats-card card flex-between">
    <view class="stat-col flex-col flex-center">
      <text class="stat-num text-primary text-bold">{{myStats.publishCount || 0}}</text>
      <text class="stat-label text-secondary text-sm">发布</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-col flex-col flex-center">
      <text class="stat-num text-primary text-bold">{{myStats.likeCount || 0}}</text>
      <text class="stat-label text-secondary text-sm">获赞</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-col flex-col flex-center">
      <text class="stat-num text-primary text-bold">{{myStats.viewCount || 0}}</text>
      <text class="stat-label text-secondary text-sm">浏览量</text>
    </view>
  </view>

  <!-- ===== 功能菜单 ===== -->
  <view class="menu-section card">
    <view class="menu-title">我的内容</view>
    <view class="menu-item" bindtap="onMenuTap" data-key="myPublish">
      <text class="menu-icon">📋</text>
      <text class="menu-label flex-1">我的发布</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-key="myLike">
      <text class="menu-icon">❤️</text>
      <text class="menu-label flex-1">我的点赞</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-section card">
    <view class="menu-title">设置</view>
    <view class="menu-item" bindtap="onMenuTap" data-key="about">
      <text class="menu-icon">🏫</text>
      <text class="menu-label flex-1">关于书院</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-key="feedback">
      <text class="menu-icon">💬</text>
      <text class="menu-label flex-1">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onMenuTap" data-key="privacy">
      <text class="menu-icon">🔒</text>
      <text class="menu-label flex-1">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- ===== 退出登录 ===== -->
  <view class="page-content">
    <button class="btn-outline logout-btn" bindtap="onLogout">退出登录</button>
  </view>

  <view class="profile-footer">
    <text class="text-secondary text-sm">南京大学健雄书院 © 2024</text>
    <text class="text-secondary text-sm">Version 1.0.0</text>
  </view>

</view>