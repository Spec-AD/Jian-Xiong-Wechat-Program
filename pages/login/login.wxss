/* pages/login/login.wxss */

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(160deg, #4A2C6E 0%, #7B4FA6 50%, #F5F5F5 100%);
}

/* ===== 顶部头部 ===== */
.login-header {
  width: 100%;
  padding: 100rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.login-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.2);
  margin-bottom: 24rpx;
}

.login-title {
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.login-subtitle {
  color: rgba(255,255,255,0.80);
  font-size: 26rpx;
  margin-top: 12rpx;
}

/* ===== 登录卡片 ===== */
.login-card {
  width: calc(100% - 64rpx);
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(74,44,110,0.18);
}

/* ===== 用户预览 ===== */
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #4A2C6E;
}

/* ===== 微信授权按钮 ===== */
.btn-weixin {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  width: 100%;
  border: none;
}

.btn-weixin::after { border: none; }

.weixin-icon {
  width: 44rpx;
  height: 44rpx;
}

/* ===== 昵称输入 ===== */
.nickname-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.nickname-label {
  color: #888;
  font-size: 28rpx;
  white-space: nowrap;
  margin-right: 8rpx;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ===== 底部 ===== */
.login-footer {
  margin-top: auto;
  padding: 48rpx 0 60rpx;
  text-align: center;
}