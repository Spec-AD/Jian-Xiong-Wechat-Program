/* pages/hall/hall.wxss */

.hall-page {
  background: var(--color-bg);
  min-height: 100vh;
}

/* ===== 搜索栏 ===== */
.search-bar {
  background: #4A2C6E;
  padding: 16rpx 24rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
}

.search-input::placeholder { color: rgba(255,255,255,0.55); }

.search-clear {
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  padding: 0 4rpx;
}

/* ===== 分类筛选 ===== */
.category-scroll {
  background: #FFFFFF;
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  white-space: nowrap;
}

.category-list {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  gap: 16rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 30rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
  white-space: nowrap;
  flex-shrink: 0;
  transition: all 0.2s;
}

.category-item--active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== Banner 轮播 ===== */
.banner-swiper {
  width: 100%;
  height: 340rpx;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 340rpx;
}

.banner-title-wrap {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 24rpx 24rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.65), transparent);
}

.banner-title {
  display: block;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
}

.banner-author {
  color: rgba(255,255,255,0.80);
  margin-top: 4rpx;
}

/* ===== 成果卡片 ===== */
.achievement-card {
  padding: 0;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.card-cover-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.card-cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

/* 类型角标 */
.file-type-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.badge-image  { background: rgba(74, 44, 110, 0.85); }
.badge-video  { background: rgba(220, 53, 69, 0.85); }
.badge-audio  { background: rgba(40, 167, 69, 0.85); }
.badge-pdf    { background: rgba(255, 127, 0, 0.85); }
.badge-unknown { background: rgba(100,100,100,0.75); }

/* 内容区 */
.card-body {
  padding: 24rpx 28rpx 28rpx;
}

.card-title {
  font-size: 30rpx;
  color: var(--color-text);
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.card-meta {
  border-top: 1rpx solid var(--color-border);
  padding-top: 16rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

/* ===== 列表头 ===== */
.list-header {
  padding: 0 4rpx;
}